# Copy this file to `.env` and fill in real values. `.env` is ignored by git.

# --- Neo4j (graph database behind Graphiti) ---
# Inside Docker Compose the API reaches Neo4j at bolt://neo4j:7687.
# From your own machine (e.g. running tests) use bolt://localhost:7687.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please

# --- LLM for extraction and answers, embeddings for search ---
# Provider: gemini (default) or openai. One key covers extraction, embeddings and reranking.
LLM_PROVIDER=gemini
# Create a Gemini key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Or, with LLM_PROVIDER=openai: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional: override the default models (Gemini: gemini-3.5-flash-lite, gemini-embedding-001).
# The Gemini free tier allows only ~20 requests/day for gemini-3.5-flash; with billing enabled,
# LLM_MODEL=gemini-3.5-flash extracts better.
# LLM_MODEL=
# LLM_SMALL_MODEL=
# EMBEDDING_MODEL=
# Parallel LLM calls (raise on paid plans) and rate limit retries
# LLM_MAX_CONCURRENCY=2
# RATE_LIMIT_RETRIES=5

# Industry packs on top of the core ontology
ONTOLOGY_PACKS=["retail"]

# Turn off Graphiti's anonymous usage telemetry.
GRAPHITI_TELEMETRY_ENABLED=false
